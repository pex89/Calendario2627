rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Risultati: lettura e scrittura aperte (la password è solo sul sito).
    // Regole senza data di scadenza, a differenza della "modalità di prova".
    match /risultati/{id} {
      allow read, write: if true;
    }
    // Elenco giocatori modificato dal sito
    match /impostazioni/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
